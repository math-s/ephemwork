[tunnel]
# Identifier for this project. Used to derive AWS resource names
# (ephemwork-<project_name>-bastion, -sg, -role, -instance-profile),
# so two projects in the same AWS account never collide.
project_name = "myproject"
type = "ec2"
region = "us-east-1"
instance_type = "t4g.nano"

# Optional but strongly recommended: pin the staging VPC ID. If set,
# `bastion init --live` looks up the supplied --subnet-id first and
# refuses to provision when the subnet's VPC differs. Cheap insurance
# against accidentally creating a bastion in prod.
# expected_vpc_id = "vpc-0123456789abcdef0"

[service.backend]
port = 8080
build_command = "cargo build"
run_command = "cargo run"
health_check_path = "/health"
# Optional: shell command run before run_command on every `ephemwork up`.
# Use it to hydrate env files (e.g. fetch staging credentials), apply
# migrations, etc. Aborts the up flow on non-zero exit.
# bootstrap_command = "./scripts/bootstrap-staging-env.sh"

[service.worker]
port = 9090
run_command = "python worker.py"

# Worker service: no inbound HTTP routing. Omit `port` (or set to 0 — the
# CLI rejects 0 with a clear error pointing here). ephemwork just runs
# bootstrap_command + run_command. Use this for SQS pollers, cron jobs,
# or anything that talks to AWS directly without receiving HTTP from the
# staging ALB. Workers can't declare forward_ports; run an HTTP service
# alongside (e.g. `ephemwork up api`) to share its tunnels.
[service.engine-worker]
run_command = "uv run python -m app.lambdas.run_local engine_worker"
